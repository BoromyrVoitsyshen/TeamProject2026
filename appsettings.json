{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "Agent": {
    "TimeoutSeconds": 120,
    "Models": [
      "nvidia/nemotron-3.5-super-vl:free",
      "openrouter/free"
    ],
    "MaxHistoryMessages": 20,
    "MaxTokens": 1500,
    "Temperature": 0.5,
    "CheckModelsOnStartup": true
  },
  "Storage": {
    "DataPath": "data"
  }
}
